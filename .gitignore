# ═══════════════════════════════════════════════════════════
#  VendorBridge — Root .gitignore
#  Covers: backend (Node.js/Express) + frontend (React/Vite)
# ═══════════════════════════════════════════════════════════

# ─── Environment / Secrets ────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.staging
*.pem
*.key
*.p12
*.pfx
secrets/

# ─── Dependencies ─────────────────────────────────────────
node_modules/
.pnp
.pnp.js
.yarn/install-state.gz

# ─── Build Outputs ────────────────────────────────────────
dist/
dist-ssr/
build/
out/
.next/
.nuxt/

# ─── Uploads / User Content ───────────────────────────────
backend/uploads/*
!backend/uploads/.gitkeep
uploads/*
!uploads/.gitkeep
*.xlsx
*.docx

# ─── Logs ─────────────────────────────────────────────────
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ─── Runtime / Cache ──────────────────────────────────────
*.pid
*.seed
*.pid.lock
.npm
.eslintcache
.stylelintcache
.cache/
.parcel-cache/
*.tsbuildinfo

# ─── Testing ──────────────────────────────────────────────
coverage/
.nyc_output

# ─── OS Generated Files ───────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ─── Editor / IDE ─────────────────────────────────────────
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
*.swp

# ─── Misc ─────────────────────────────────────────────────
*.local
.vercel
.netlify
