# VendorBridge Backend — Environment Variables
# ─────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in your values below
# 3. NEVER commit the .env file — it is listed in .gitignore
# ─────────────────────────────────────────────────────────────

# ─── Server ───────────────────────────────────────────────────
PORT=5000
NODE_ENV=development

# ─── Database (PostgreSQL / Supabase) ─────────────────────────
# Option A – Supabase Transaction Pooler URL (recommended)
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Option B – Direct local PostgreSQL
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=vendorbridge_db
# DB_USER=postgres
# DB_PASSWORD=your_postgres_password

DB_SSL=true

# ─── JWT ──────────────────────────────────────────────────────
# Generate strong secrets: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_min_32_chars_here
JWT_REFRESH_SECRET=your_refresh_secret_key_min_32_chars_here
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Email (Nodemailer via Gmail SMTP) ────────────────────────
# Gmail App Password: https://myaccount.google.com/apppasswords
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=your_email@gmail.com
MAIL_PASS=your_gmail_app_password_16_chars
MAIL_FROM=VendorBridge <noreply@vendorbridge.com>

# ─── Groq AI (LLaMA 3.3 70B) ─────────────────────────────────
# Get your key: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# ─── File Upload ──────────────────────────────────────────────
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760
ALLOWED_FILE_TYPES=pdf,xlsx,docx,jpg,jpeg,png

# ─── CORS ─────────────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Rate Limiting ────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=200
AUTH_RATE_LIMIT_MAX=10

# ─── OTP ──────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=15
